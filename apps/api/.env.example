# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Comma-separated origins allowed by CORS. Optional outside production, where it defaults to
# the Vite dev server.
CORS_ORIGINS=http://localhost:5173
# The dev Supabase project's session pooler URL (port 5432), from Project Settings > Database.
# Use sslmode=disable only for a database on localhost.
DATABASE_URL=
# Path to Supabase's CA certificate (Project Settings > Database > SSL configuration). Without it
# the connection is encrypted but the server's certificate is not verified. Required in production.
# DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt
# console only logs that a message would be sent (development and tests); termii sends real SMS
# and is required in production.
SMS_PROVIDER=console
# Required when SMS_PROVIDER=termii. Each Termii account has its own base URL, on its dashboard.
# TERMII_API_KEY=
# TERMII_SENDER_ID=ColdLink
# TERMII_BASE_URL=https://v3.api.termii.com
# dnd (the default) also reaches numbers on Do-Not-Disturb, and must be enabled on the account by
# Termii support; generic does not reach them.
# TERMII_CHANNEL=dnd
# Sign access tokens and key the OTP hash. Each at least 32 characters of random data, different
# from each other and per environment; generate with:
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=
OTP_PEPPER=
# SameSite for the refresh cookie: strict (default) when the web app and API share a site, such
# as localhost or coldlink.ng with api.coldlink.ng; none only if they are on different sites.
# AUTH_COOKIE_SAME_SITE=strict
# Facility photos go to Supabase Storage (bucket provider-photos). Both required in production and
# set together elsewhere; without them only the photo routes fail. The service-role key is in
# Project Settings > API, bypasses RLS and must never reach the browser.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Proxies in front of the API whose X-Forwarded-For gives the client IP: 1 on Render or Railway.
# TRUST_PROXY_HOPS=0
