# Copy to apps/e2e/.env for a local run. Never commit .env.
# Paystack's test secret key, the same one the API uses. Anything but sk_test_ is refused.
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_
# The database the API under test uses. The suite writes to it once per run: it approves the run's
# own facility, until the admin API (#46) can. Use a local database if you have one; against dev,
# follow the dev guardrails in docs/decisions.md (decision 131).
E2E_DATABASE_URL=
# Leave both unset to start the built API and web app on this machine. Set both to test a running
# deployment, such as staging later; nothing is started then.
# E2E_WEB_URL=https://staging.example.com
# E2E_API_URL=https://staging.example.com/api/v1
