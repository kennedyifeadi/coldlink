# Copy to apps/web/.env.local to override. Never commit .env files.
# Base URL of the API, without a trailing slash. The default, /api/v1, is the same origin: in
# development the Vite dev server proxies /api to the API on http://localhost:3000, so the
# refresh cookie (SameSite=Strict, Path=/api/v1/auth) works without cross-site settings.
VITE_API_URL=/api/v1
