{
  "name": "coldlink",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build:shared": "pnpm --filter @coldlink/shared build",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm build:shared && pnpm -r --if-present run lint",
    "typecheck": "pnpm build:shared && pnpm -r --if-present run typecheck",
    "test": "pnpm build:shared && pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "supabase migration new",
    "db:push": "node --env-file=apps/api/.env scripts/db-push.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0"
  }
}
